<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.headroom" path="/org/gnome/shell/extensions/headroom/">
    <key name="claude-enabled" type="b"><default>true</default><summary>Enable Claude Code</summary></key>
    <key name="claude-top-bar" type="b"><default>true</default><summary>Show Claude Code in top bar</summary></key>
    <key name="codex-enabled" type="b"><default>true</default><summary>Enable Codex</summary></key>
    <key name="codex-top-bar" type="b"><default>true</default><summary>Show Codex in top bar</summary></key>
    <key name="provider-order" type="as"><default>['claude', 'codex']</default><summary>Provider display order</summary></key>
    <key name="cost-enabled" type="b"><default>true</default><summary>Show local cost estimates</summary></key>
    <key name="cost-position" type="i"><range min="0" max="2"/><default>2</default><summary>Cost section position</summary></key>
    <key name="demo-mode" type="b"><default>false</default><summary>Use synthetic preview data</summary></key>
  </schema>
</schemalist>
